@model IEnumerable<CustomerDocument>

@{
    ViewData["Title"] = "Customers";
}

<h2>Customers</h2>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Company</th>
            <th>Email</th>
            <th>Phone</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.FirstName</td>
            <td>@item.LastName</td>
            <td>@item.CompanyName</td>
            <td>@item.EmailAddress</td>
            <td>@item.Phone</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.CustomerId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.CustomerId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.CustomerId">Delete</a> |
                <a asp-controller="SalesOrders" asp-action="Index" asp-route-customerId="@item.CustomerId">Orders</a>
            </td>
        </tr>
}
    </tbody>
</table>

@if (ViewData["ContinuationToken"] != null)
{
    <a asp-action="Index" asp-route-continuationToken="@ViewData["ContinuationToken"]" class="btn btn-default">Next Page &raquo;</a>
}
