@model ProductDocument

@{
    ViewData["Title"] = "Product Details";
}

<h2>Product Details</h2>

<div>
    <h4>@Model.Name</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>Product Number</dt><dd>@Model.ProductNumber</dd>
        <dt>Color</dt><dd>@Model.Color</dd>
        <dt>Standard Cost</dt><dd>@Model.StandardCost.ToString("C")</dd>
        <dt>List Price</dt><dd>@Model.ListPrice.ToString("C")</dd>
        <dt>Size</dt><dd>@Model.Size</dd>
        <dt>Weight</dt><dd>@Model.Weight</dd>
        <dt>Category</dt><dd>@Model.Category?.Name</dd>
        <dt>Model</dt><dd>@Model.Model?.Name</dd>
        <dt>Sell Start Date</dt><dd>@Model.SellStartDate</dd>
        <dt>Sell End Date</dt><dd>@Model.SellEndDate</dd>
        <dt>Discontinued Date</dt><dd>@Model.DiscontinuedDate</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.ProductId">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
