@model IEnumerable<ProductDocument>

@{
    ViewData["Title"] = "Products";
}

<h2>Products</h2>

<p><a asp-action="Create">Create New</a></p>
<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Product Number</th>
            <th>Color</th>
            <th>List Price</th>
            <th>Category</th>
            <th>Model</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.Name</td>
            <td>@item.ProductNumber</td>
            <td>@item.Color</td>
            <td>@item.ListPrice.ToString("C")</td>
            <td>@item.Category?.Name</td>
            <td>@item.Model?.Name</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ProductId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.ProductId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.ProductId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

@if (ViewData["ContinuationToken"] != null)
{
    <a asp-action="Index" asp-route-continuationToken="@ViewData["ContinuationToken"]" class="btn btn-default">Next Page &raquo;</a>
}
